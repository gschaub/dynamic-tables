diff --git a/src/components/cell-advanced-edit-modal/value.js b/src/components/cell-advanced-edit-modal/value.js
new file mode 100644
--- /dev/null
+++ b/src/components/cell-advanced-edit-modal/value.js
@@ -0,0 +1,111 @@
+import { escapeAttribute, escapeEditableHTML } from '@wordpress/escape-html';
+import { __ } from '@wordpress/i18n';
+import { htmlToIndexText } from '../../utils';
+
+// Accept web links, including relative URLs, but reject executable schemes.
+export function isWebUrl(value) {
+	if (typeof value !== 'string' || !value.trim()) return false;
+	try {
+		const { protocol } = new URL(value.trim(), 'https://wordpress.invalid/');
+		return protocol === 'http:' || protocol === 'https:';
+	} catch {
+		return false;
+	}
+}
+
+// Recover the URL from legacy cached HTML without attaching it to the document.
+function cachedLinkUrl(content) {
+	if (typeof document === 'undefined') return '';
+	const template = document.createElement('template');
+	template.innerHTML = String(content || '');
+	return template.content.querySelector('a')?.getAttribute('href') || '';
+}
+
+export function normalizeAttributes(value = {}, content = '', contentType) {
+	const cannonical = { ...value?.cannonical },
+		options = { ...value?.options },
+		meta = { ...value?.meta };
+	if (options.newTab == null && typeof cannonical.newTab === 'boolean')
+		options.newTab = cannonical.newTab;
+	delete cannonical.newTab;
+	if (contentType === 'post') {
+		meta.url = meta.url || cannonical.url || cachedLinkUrl(content);
+		delete cannonical.url;
+	}
+	let indexText = value?.indexText;
+	if (typeof indexText !== 'string')
+		indexText =
+			contentType === 'link'
+				? String(cannonical.label || '')
+				: htmlToIndexText(String(content || ''));
+	const attributes = { ...value, cannonical, options, meta, indexText };
+	if (contentType === 'post') {
+		attributes.refs = Array.isArray(value?.refs)
+			? value.refs.filter(
+					ref =>
+						ref &&
+						typeof ref === 'object' &&
+						Object.keys(ref).length &&
+						(!('postId' in ref) || Number(ref.postId) > 0)
+				)
+			: [];
+		if (!attributes.refs.length && Number(cannonical.postId) > 0)
+			attributes.refs = [{ postId: Number(cannonical.postId) }];
+	}
+	return attributes;
+}
+
+export function getPostOption(attributes) {
+	const postId = Number(attributes?.cannonical?.postId);
+	if (!Number.isSafeInteger(postId) || postId <= 0) return null;
+	return {
+		value: String(postId),
+		label: attributes.indexText || __('No title found', 'dynamic-table-blocks'),
+		postType: attributes.cannonical.postType || 'post',
+	};
+}
+
+export function getNewTab(attributes, columnOptions = {}) {
+	return Boolean(attributes.options?.newTab ?? columnOptions.newTab ?? false);
+}
+
+// Serialize plain text and URL attributes through one shared rendering path.
+export function buildCellContent(contentType, attributes, columnOptions = {}) {
+	const isPost = contentType === 'post';
+	if (isPost && !getPostOption(attributes)) return '';
+	const label = String(isPost ? attributes.indexText || '' : attributes.cannonical?.label || '');
+	const url = String(isPost ? attributes.meta?.url || '' : attributes.cannonical?.url || '').trim();
+	const text = escapeEditableHTML(label);
+	if (!isWebUrl(url)) return text;
+	const target = getNewTab(attributes, columnOptions)
+		? ' target="_blank" rel="noopener noreferrer"'
+		: ' target="_top"';
+	return '<a href="' + escapeAttribute(url) + '"' + target + '>' + text + '</a>';
+}
+
+export function withPostDetails(attributes, post) {
+	return {
+		...attributes,
+		cannonical: {
+			...attributes.cannonical,
+			postId: post.postId,
+			postType: post.postType,
+		},
+		refs: [{ postId: post.postId }],
+		meta: { url: post.url },
+		indexText: post.title,
+	};
+}
+
+export function withoutPostDetails(attributes) {
+	const cannonical = { ...attributes.cannonical };
+	delete cannonical.postId;
+	delete cannonical.postType;
+	return {
+		...attributes,
+		cannonical,
+		refs: [],
+		meta: {},
+		indexText: '',
+	};
+}
