+function useLatestRequest() {
+	const ref = useRef(null);
+	useEffect(
+		() => () => {
+			ref.current?.abort();
+			ref.current = null;
+		},
+		[]
+	);
+	const cancel = () => {
+		ref.current?.abort();
+		ref.current = null;
+	};
+	const begin = () => {
+		cancel();
+		const controller = new AbortController();
+		ref.current = controller;
+		return controller;
+	};
+	const isCurrent = controller => ref.current === controller && !controller.signal.aborted;
+	const finish = controller => {
+		if (!isCurrent(controller)) return false;
+		ref.current = null;
+		return true;
+	};
+	return { ref, begin, cancel, isCurrent, finish };
+}
