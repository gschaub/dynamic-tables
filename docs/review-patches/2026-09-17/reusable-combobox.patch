diff --git a/src/hooks/use-latest-request.js b/src/hooks/use-latest-request.js
new file mode 100644
--- /dev/null
+++ b/src/hooks/use-latest-request.js
@@ -0,0 +1,36 @@
+import { useRef, useEffect } from '@wordpress/element';
+
+/**
+ * Keep only the last edit request.
+ *
+ * @since    1.4.10
+ * Keep only the latest request active and abort it when the modal unmounts.
+ */
+export function useLatestRequest() {
+	const ref = useRef(null);
+	useEffect(
+		() => () => {
+			ref.current?.abort();
+			ref.current = null;
+		},
+		[]
+	);
+	const cancel = () => {
+		ref.current?.abort();
+		ref.current = null;
+	};
+	const begin = () => {
+		cancel();
+		const requestHandler = new AbortController();
+		ref.current = requestHandler;
+		return requestHandler;
+	};
+	const isCurrent = requestHandler =>
+		ref.current === requestHandler && !requestHandler.signal.aborted;
+	const finish = requestHandler => {
+		if (!isCurrent(requestHandler)) return false;
+		ref.current = null;
+		return true;
+	};
+	return { ref, begin, cancel, isCurrent, finish };
+}
diff --git a/src/hooks/use-async-combobox.js b/src/hooks/use-async-combobox.js
new file mode 100644
--- /dev/null
+++ b/src/hooks/use-async-combobox.js
@@ -0,0 +1,154 @@
+import { useState } from '@wordpress/element';
+import { __ } from '@wordpress/i18n';
+import { useLatestRequest } from './use-latest-request';
+
+// Each call owns one combobox's selection, results, and requests.
+// searchOptions(text, { signal }) returns ComboboxControl options.
+// resolveOption(option, { signal }) returns { option, data }.
+// onChange(data) receives the resolved item, or null when cleared.
+export function useAsyncCombobox({
+	initialOption = null,
+	searchOptions,
+	resolveOption,
+	onChange,
+	minimumSearchLength = 3,
+}) {
+	const [selectedOption, setSelectedOption] = useState(initialOption);
+	const [searchResults, setSearchResults] = useState([]);
+	const [isSearching, setIsSearching] = useState(false);
+	const [isLoading, setIsLoading] = useState(false);
+	const [searchError, setSearchError] = useState('');
+	const [error, setError] = useState('');
+	const searchRequest = useLatestRequest();
+	const selectionRequest = useLatestRequest();
+	const value = selectedOption?.value ?? null;
+	const options =
+		selectedOption && !searchResults.some(option => option.value === value)
+			? [selectedOption, ...searchResults]
+			: searchResults;
+
+	function cancelSearch() {
+		searchRequest.cancel();
+		setIsSearching(false);
+	}
+
+	function cancel() {
+		cancelSearch();
+		selectionRequest.cancel();
+		setIsLoading(false);
+	}
+
+	function isPending() {
+		return selectionRequest.ref.current !== null;
+	}
+
+	async function search(text) {
+		cancelSearch();
+		setSearchError('');
+		const term = String(text ?? '').trim();
+		const noResults = [
+			{
+				value: '',
+				label: __('No matching content found or search term is too short.', 'dynamic-table-blocks'),
+				disabled: true,
+			},
+		];
+
+		if (!term && selectedOption) {
+			setSearchResults([]);
+			return;
+		}
+		if (term.length < minimumSearchLength) {
+			setSearchResults(noResults);
+			return;
+		}
+
+		const request = searchRequest.begin();
+		setIsSearching(true);
+		try {
+			const results = await searchOptions(term, { signal: request.signal });
+			if (!searchRequest.isCurrent(request)) {
+				return;
+			}
+			setSearchResults(results.length ? results : noResults);
+		} catch (searchFailure) {
+			if (searchRequest.isCurrent(request)) {
+				setSearchResults([]);
+				setSearchError(
+					searchFailure?.message || __('The search failed. Try again.', 'dynamic-table-blocks')
+				);
+			}
+		} finally {
+			if (searchRequest.finish(request)) {
+				setIsSearching(false);
+			}
+		}
+	}
+
+	// The optional callback lets another field refresh the same selection
+	// and apply its own update, such as changing the post's new-tab option.
+	async function select(nextValue, applySelection = onChange) {
+		cancel();
+		setError('');
+		setSearchError('');
+		if (nextValue === null || nextValue === '') {
+			setSelectedOption(null);
+			setSearchResults([]);
+			applySelection(null);
+			return;
+		}
+
+		const option = options.find(item => item.value === String(nextValue) && !item.disabled);
+		if (!option) {
+			setError(__('Choose an item from the search results.', 'dynamic-table-blocks'));
+			return;
+		}
+
+		setSelectedOption(option);
+		const request = selectionRequest.begin();
+		setIsLoading(true);
+		try {
+			const result = await resolveOption(option, { signal: request.signal });
+			if (!selectionRequest.isCurrent(request)) {
+				return;
+			}
+			setSelectedOption(result.option);
+			setSearchResults(previous =>
+				previous.map(item => (item.value === result.option.value ? result.option : item))
+			);
+			applySelection(result.data);
+		} catch (selectionFailure) {
+			if (selectionRequest.isCurrent(request)) {
+				setError(
+					selectionFailure?.message ||
+						__('The item could not be loaded. Select it again to retry.', 'dynamic-table-blocks')
+				);
+			}
+		} finally {
+			if (selectionRequest.finish(request)) {
+				setIsLoading(false);
+			}
+		}
+	}
+
+	function refresh(applySelection = onChange) {
+		return select(value, applySelection);
+	}
+
+	return {
+		selectedOption,
+		value,
+		options,
+		isSearching,
+		isLoading,
+		searchError,
+		error,
+		setError,
+		search,
+		select,
+		refresh,
+		cancelSearch,
+		cancel,
+		isPending,
+	};
+}
